{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm ls *)",
      "Bash(node scripts/user-journey.mjs)",
      "Bash(npx vitest *)",
      "Bash(node scripts/ecdict-to-dict.js)",
      "Bash(node -e ' *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pre-commit-check.mjs",
            "timeout": 120
          }
        ]
      }
    ]
  }
}

{
  "name": "word-classifier",
  "version": "1.0.0",
  "description": "单词分类app - 导入、管理、分类和导出英语单词表",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "postbuild": "node -e \"const fs=require('fs');const p=require('path');const d='out/resources';fs.mkdirSync(d,{recursive:true});for(const f of ['ecdict-dict.json','ecdict-lite.json','dictionary.json']){try{fs.copyFileSync(p.join('resources',f),p.join(d,f))}catch(e){}};console.log('dict copied')\"",
    "dev": "npm run postbuild && electron-vite dev",
    "build": "electron-vite build && npm run postbuild",
    "preview": "electron-vite preview",
    "package:win": "electron-vite build && electron-builder --win",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:all": "electron-vite build && electron-builder --win --mac",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "jschardet": "^3.1.0",
    "papaparse": "^5.5.0",
    "pdf-parse": "^1.1.1",
    "sql.js": "^1.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^28.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.460.0",
    "playwright-core": "^1.62.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.0",
    "vitest": "^4.1.10",
    "zustand": "^5.0.1"
  }
}

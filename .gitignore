# 依赖包（几百MB，不需要存档，npm install 就能装回来）
node_modules/

# 构建输出（每次构建都会重新生成）
out/
dist/

# 数据库文件（你的个人单词数据，不上传到云端）
*.db

# 打包产物
*.exe
*.zip
*.dmg
# 演示成果压缩包例外：随仓库分发（README 里介绍的语义分类演示数据）
!四六级单词分类成果.zip

# 系统文件
.DS_Store
Thumbs.db

# 临时文件
*.log
.tmp/

# 大词典文件（太大不入库，可以重新下载/生成）
resources/ecdict.json
resources/ecdict-dict.json
resources/ecdict.csv
resources/DB.Browser.for.SQLite.zip
# 精简版词典例外：随仓库分发，克隆即可用（node scripts/make-lite-dict.mjs 可重新生成）
!resources/ecdict-lite.json
node_modules

# 用户旅程测试截图
shots/

# 编辑器个人配置
.vscode/

# 质量门通行证（临时状态，不入库；签发/校验脚本 .claude/gates/sign.mjs 入库）
.claude/gates/*.pass
